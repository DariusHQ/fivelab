root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
indent_size = 4

# Vendored files keep their upstream formatting.
[src/core/scripting/lua/vendor/*.lua]
indent_style = unset
indent_size = unset

[*.md]
trim_trailing_whitespace = false
